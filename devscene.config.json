{
  "version": 1,
  "projectName": "devscene",
  "defaultBranch": "dev",
  "protectedBranches": [
    "main",
    "dev",
    "publish"
  ],
  "stateDir": "harness-runs",
  "appDir": ".",
  "scriptsDir": "scripts",
  "githooksDir": "githooks",
  "agentModel": "opus",
  "pushEnvPath": ".claude/push-notify.env",
  "detection": {
    "preset": "monorepo",
    "signal": "monorepo:workspaces-key",
    "evidence": "package.json#workspaces",
    "commandFamily": "npm",
    "review": {
      "verdict": "applied",
      "rationale": "Read docs-retrieval-service/pyproject.toml, graphscene/pyproject.toml, graphscene/README.md and scripts/python-service.sh PACKAGES; the two Python packages (ruff/mypy/pytest via scripts/python-service.sh) fell to the general catch-all and no conventions document covered them, so each was given its own layer and conventions document beside cli, plugin and the retained general catch-all at path .",
      "at": "2026-11-19"
    }
  },
  "layers": [
    {
      "name": "cli",
      "path": "cli",
      "conventions": ".claude/context/cli.md"
    },
    {
      "name": "plugin",
      "path": "plugin",
      "conventions": ".claude/context/plugin.md"
    },
    {
      "name": "docs-retrieval",
      "path": "docs-retrieval-service",
      "conventions": ".claude/context/docs-retrieval.md"
    },
    {
      "name": "graphscene",
      "path": "graphscene",
      "conventions": ".claude/context/graphscene.md"
    },
    {
      "name": "general",
      "path": ".",
      "conventions": ".claude/context/conventions.md"
    }
  ],
  "commands": {
    "typecheck": "bash scripts/typecheck.sh",
    "test": "bash scripts/test.sh",
    "build": "npm run build",
    "depInstall": "npm ci && if grep -qx '# PROVIDES: provision' scripts/python-service.sh 2>/dev/null; then bash scripts/python-service.sh provision; else echo 'python-service: provision: SKIPPED - this checkout has no provision sub-command; gate 13 grades BLOCKED' >&2; fi"
  },
  "phases": {
    "qa": false,
    "docs": false,
    "parity": false
  },
  "treeGuards": [
    {
      "test": "test/main-anchor-isolation.test.mjs",
      "covers": "cli/test/**/*.mjs"
    },
    {
      "test": "test/shipped-scripts-mktemp.test.mjs",
      "covers": "cli/templates/scripts/**/*.sh"
    },
    {
      "test": "test/retrieval-loading.test.mjs",
      "covers": "cli/src/**/*.ts"
    },
    {
      "test": "test/watcher-main-anchor.test.mjs",
      "covers": "cli/templates/scripts/**"
    },
    {
      "test": "test/main-repo-resolution-corpus.test.mjs",
      "covers": "plugin/**/*.md"
    },
    {
      "test": "test/jq-floor.test.mjs",
      "covers": "cli/templates/scripts/**/*.jq"
    },
    {
      "test": "test/no-container-home-paths.test.mjs",
      "covers": "**/*.md"
    },
    {
      "test": "test/untrusted-input-corpus.test.mjs",
      "covers": "plugin/**/*.md"
    },
    {
      "test": "test/commit-step-calls.test.mjs",
      "covers": "plugin/**/*.md"
    },
    {
      "test": "test/agent-return-schemas.test.mjs",
      "covers": "plugin/**/*.md"
    },
    {
      "test": "test/agent-return-schemas.test.mjs",
      "covers": "cli/templates/scripts/**"
    },
    {
      "test": "test/agent-return-schemas.test.mjs",
      "covers": "plugin/schemas/**"
    },
    {
      "test": "test/agent-return-schemas.test.mjs",
      "covers": "docs/structured-agent-returns.md"
    },
    {
      "test": "test/must-fix-triggers-corpus.test.mjs",
      "covers": "plugin/agents/*.md"
    },
    {
      "test": "test/must-fix-triggers-corpus.test.mjs",
      "covers": "plugin/instructions/finding_grades.md"
    }
  ],
  "execution": {
    "scriptDrivenPlanning": true
  }
}
